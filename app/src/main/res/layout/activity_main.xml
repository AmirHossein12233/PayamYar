<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="پیام‌یار"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGroups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnUsers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- Recent chats -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        android:text="چت‌های اخیر"
        android:textSize="19sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/scrollRecentChats"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/layoutRecentChats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!-- Online users -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        android:text="کاربران آنلاین"
        android:textSize="19sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutUsers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp" />

    </HorizontalScrollView>

    <!-- Center -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtSelectedUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 یک کاربر را انتخاب کنید"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/txtMessages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="برای شروع، یک کاربر را انتخاب کنید"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- Hidden old message controls -->

    <ScrollView
        android:id="@+id/scrollMessages"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone">

        <TextView
            android:layout_width="1dp"
            android:layout_height="1dp" />

    </ScrollView>

    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/edtMessage"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="1dp"
            android:layout_height="1dp" />

    </LinearLayout>

</LinearLayout>
